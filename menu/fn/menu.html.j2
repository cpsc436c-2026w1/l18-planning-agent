<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Dinners for the week</title></head>
<body style="font-family: Helvetica, Arial, sans-serif; color: #1a1a1a; max-width: 640px; margin: 0 auto; padding: 16px;">
<h1 style="font-size: 20px; margin: 0 0 4px;">Dinners for the week</h1>
<p style="margin: 0 0 16px; color: #555;">You asked: {{ request }}</p>
<table style="border-collapse: collapse; width: 100%;">
<thead>
<tr>
<th style="text-align: left; border-bottom: 2px solid #1a1a1a; padding: 6px 8px 6px 0;">Day</th>
<th style="text-align: left; border-bottom: 2px solid #1a1a1a; padding: 6px 8px;">Dish</th>
<th style="text-align: left; border-bottom: 2px solid #1a1a1a; padding: 6px 8px;">Product</th>
<th style="text-align: right; border-bottom: 2px solid #1a1a1a; padding: 6px 0 6px 8px;">USD</th>
</tr>
</thead>
<tbody>
{% for p in picks %}
<tr>
<td style="border-bottom: 1px solid #ddd; padding: 6px 8px 6px 0;">{{ loop.index }}</td>
<td style="border-bottom: 1px solid #ddd; padding: 6px 8px;">{{ p.dish }}</td>
<td style="border-bottom: 1px solid #ddd; padding: 6px 8px;">{% if p.code %}{{ p.name }}{% else %}no product found{% endif %}</td>
<td style="border-bottom: 1px solid #ddd; padding: 6px 0 6px 8px; text-align: right;">{% if p.code %}{{ p.price_usd | usd }}{% endif %}</td>
</tr>
{% endfor %}
</tbody>
<tfoot>
<tr>
<td colspan="3" style="padding: 8px 8px 2px 0; font-weight: bold;">Total</td>
<td style="padding: 8px 0 2px 8px; text-align: right; font-weight: bold;">{{ total_usd | usd }}</td>
</tr>
<tr>
<td colspan="3" style="padding: 2px 8px 2px 0;">Budget</td>
<td style="padding: 2px 0 2px 8px; text-align: right;">{{ budget_usd | usd }}</td>
</tr>
</tfoot>
</table>
{% if over_budget %}
<p style="margin: 16px 0; padding: 8px 12px; background: #fde8e8; border-left: 4px solid #b42318;"><strong>Over the budget by {{ (-left_usd) | usd }} USD.</strong></p>
{% else %}
<p style="margin: 16px 0; padding: 8px 12px; background: #e8f5ec; border-left: 4px solid #1e7a3c;"><strong>Within the budget:</strong> {{ left_usd | usd }} USD left.</p>
{% endif %}
<p style="font-size: 12px; color: #555;">{{ price_note }}</p>
<p style="font-size: 12px; color: #555;">Request {{ request_id }}. One product per dish, for shopper {{ shopper }}.</p>
</body>
</html>
